		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@vercel/blob": "^2.8.0",
